{% liquid
  assign section_width = section.settings.section_width
  assign brand_menu = section.settings.brand_menu

%}
{%- render 'top-divider', show_top_divider: section.settings.show_top_divider, divider_top_width: section.settings.divider_top_width -%}
<div class="section_brand-vendor section-padding section-bg" {% render 'section-attributes' %}>
  <div class="{{ section_width }}">
    <div class="brand-vendor__inner grid gap-y-4">
      <div class="brand-vendor__grid flex md:flex-wrap gap-x-8 flex-scroll-mobile">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'character' %}
            <div class="brand-vendor__character " >
              <a data-anchor href="#jump-{{ block.settings.character | downcase }}" class="body-1 brand-vendor__character-link uppercase min-w-14 flex items-center min-h-14">{{ block.settings.character }}</a>
            </div>
        {% endcase %}
      {% endfor %}
      </div>
      <div class="brand-vendor__list">
        {% for block in section.blocks %}
          {% if block.type == 'character' %}

            {% assign current_char = block.settings.character | strip | downcase %}
            {% assign matched_item = nil %}

            {%- for item in brand_menu.links -%}
              {% assign item_title = item.title | strip | downcase %}
              {% if item_title == current_char %}
                {% assign matched_item = item %}
                {% break %}
              {% endif %}
            {%- endfor -%}

            {% if matched_item and matched_item.links.size > 0 %}
              <div class="brand-vendor__item py-6 border-b" id="jump-{{ current_char }}">
                <div class="brand-vendor__title h5 uppercase pr-12 heading-1 w-36 flex-shrink-0">
                  {{ block.settings.character }}
                </div>

                <ul class="brand-vendor__menu grid flex-1 grid-cols-1 md:grid-cols-2 lg:grid-cols-5">
                  {% for sublink in matched_item.links %}
                    <li class="brand-vendor__list-item py-2 flex items-center">
                      <a href="{{ sublink.url }}" class="brand-vendor__list-item-link">{{ sublink.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{%- render 'bottom-divider', show_bottom_divider: section.settings.show_bottom_divider, divider_bottom_width: section.settings.divider_bottom_width -%}
{% schema %}
