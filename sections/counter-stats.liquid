{{- 'counter-stats.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'counter-stats.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign content_alignment = section.settings.content_alignment
  assign block_type = section.settings.block_type
  assign use_font_body_for_target_number = section.settings.use_font_body_for_target_number
  assign use_space_blocks = section.settings.use_space_blocks
  case content_alignment
    when 'left'
      assign content_alignment = 'start'
    when 'center'
      assign content_alignment = 'center'
    when 'right'
      assign content_alignment = 'end'
  endcase
%}
{%- capture scroll_animation -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{%- endcapture -%}
{%- render 'top-divider', show_top_divider: section.settings.show_top_divider, divider_top_width: section.settings.divider_top_width -%}
<div class="section-counter-stats section-padding section-bg overflow-hidden" {% render 'section-attributes' %}>
  <div class="{{ section.settings.section_width }}">
    <div class="counter-stats grid lg:grid-cols-{{ section.blocks.size }} gap-10 lg:gap-14">
      {% for block in section.blocks %}
        {% assign custom_background_image = block.settings.custom_background_image %}
        <div 
        class="counter-stats__item {{ scroll_animation }} relative {% if block_type == 'border' %} pt-10 px-14 pb-12 border global-radius{% endif %} {% if block_type == 'background' %}pt-10 px-14 pb-12 background-secondary global-radius{% endif %}" 
        {% if settings.animations_reveal_on_scroll %} 
          data-cascade 
          style="--animation-order: {{ forloop.index }};"{% endif %}
          {{ block.shopify_attributes }}
          >
          {% if custom_background_image != blank %}
            <div class="absolute inset-0 w-full h-full">
              {% render 'responsive-image', image: custom_background_image, decoding:"async", wrapper_class: 'defer-image absolute inset-0 w-full h-full overflow-hidden z-0', class: 'absolute inset-0 w-full h-full object-cover' %}
            </div>
          {% endif %}
          <animated-counter 
          target="{{ block.settings.target }}"
          duration="{{ section.settings.duration | times: 1000 | default: 2000 }}"
          class="counter-stats__item-counter text-{{ content_alignment }} h-full {% if use_space_blocks %} flex flex-col counter-stats__item-square  {% endif %} z-[1] relative"
          >
              <div class="stat-number mb-6">
                <span class="counter-value hxl {% if use_font_body_for_target_number %} font-body {% endif %}" style="--font-heading-scale: {{ section.settings.target_number_scale | divided_by: 100.0 }};--text-size-hxl:calc(var(--font-heading-scale)*var(--size-hxl));">{{ block.settings.target }}</span>
              </div>
              <div class="stat-content perpose__content {% if use_space_blocks %} flex flex-col justify-between h-full items-{{ content_alignment }} {% endif %}">
                <div 
                class="stat-content-heading {{ section.settings.heading_size }} {%  unless use_space_blocks %} {% if content_alignment == 'center' %} mx-auto {% elsif content_alignment == 'end' %} ms-auto {% elsif content_alignment == 'start' %} me-auto {% endif %} {% endunless %}"
                >
                  {{ block.settings.heading }}
                </div>
                <div class="stat-content-text rte {% if use_space_blocks %} mt-auto {% endif %}">{{ block.settings.text }}</div>
                {%- if block.settings.button_label != blank -%}
                  {%- render 'button',
                      button_style: block.settings.button_type ,
                      button_text: block.settings.button_label,
                      button_url:  block.settings.button_link ,
                      button_type: 'link',
                      show_icon: block.settings.show_icon
                  -%}
                {%- endif -%}
              </div>
          </animated-counter>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{%- render 'bottom-divider', show_bottom_divider: section.settings.show_bottom_divider, divider_bottom_width: section.settings.divider_bottom_width -%}
{% schema %}
{
  "name": "Counter Stats",
  "class": "section--counter-stats",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "container",
        "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Wide"
        },
        {
          "value": "w-full",
          "label": "Full"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "use_space_blocks",
      "label": "Use space blocks",
      "default": false
    },
    {
      "type": "select",
      "id": "block_type",
      "label": "Block type",
      "options": [
        {
          "value": "border",
        "label": "Border"
        },
        {
          "value": "background",
          "label": "Background"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "none"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "default": "center",
      "label": "Content alignment"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        },
        {
          "value": "h4",
          "label": "Heading 4"
        },
        {
          "value": "h5",
          "label": "Heading 5"
        },
        {
          "value": "h6",
          "label": "Heading 6"
        },
        {
          "value": "body-1",
          "label": "Body 1"
        },
        {
          "value": "body-2",
          "label": "Body 2"
        },
        {
          "value": "sub-heading",
          "label": "Caption"
        }
      ],
      "default": "h4"
    },
    {
      "type": "range",
      "id": "target_number_scale",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Target number scale",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "use_font_body_for_target_number",
      "label": "Font body for target number",
      "default": false
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "duration",
      "min": 0.5,
      "max": 5,
      "step": 0.1,
      "unit": "s",
      "label": "Duration",
      "default": 2
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
        "type": "color",
        "id": "border_color",
        "label": "Border"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Section divider"
    },
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "Show top divider",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_top_width",
      "label": "Divider top width",
      "options": [
        {
          "value": "container",
          "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Wide"
        },
        {
          "value": "w-full",
          "label": "Full"
        }
      ],
      "default": "container"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_divider",
      "label": "Show bottom divider",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_bottom_width",
      "label": "Divider bottom width",
      "options": [
        {
          "value": "container",
          "label": "Boxed"
        },
        {
          "value": "container-fluid",
          "label": "Wide"
        },
        {
          "value": "w-full",
          "label": "Full"
        }
      ],
      "default": "container"
    }
  ],
  "blocks": [
    {
      "type": "counter_item",
      "name": "Counter item",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "target",
          "label": "Target number",
          "default": "100+"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Content"
        },
        {
            "type": "text",
            "id": "button_label",
            "default": "Button text",
            "label": "Button",
            "info": "Leave the label blank to hide the button."
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
          },
          {
            "type": "select",
            "id": "button_type",
            "label": "Button style",
            "options": [
              { "group": "Primary color","value": "primary","label": "Primary" },
              { "group": "Primary color","value": "outline","label": "Outline" },
              { "group": "Primary color","value": "underlined","label": "Underlined" },
              { "group": "White color","value": "primary-white","label": "Solid White" },
              { "group": "White color","value": "outline-white","label": "Outline White" },
              { "group": "White color","value": "underlined-white","label": "Underlined White" },
              { "group": "Accent color","value": "secondary","label": "Secondary" }
            ],
            "default": "primary"
          },
          {
            "type": "checkbox",
            "id": "show_icon",
            "label": "Show arrow icon",
            "default": false
          },
          {
            "type": "image_picker",
            "id": "custom_background_image",
            "label": "Custom background image",
            "info": "Recommended 1080 x 1080px .jpg"
          }
      ]
    }
  ],
  
  "presets": [
    {
      "name": "Counter Stats",
      "category": "Content",
      "blocks": [
        {
          "type": "counter_item"
        },
        {
          "type": "counter_item"
        },
        {
          "type": "counter_item"
        }
      ]
    }
  ]
}
{% endschema %}