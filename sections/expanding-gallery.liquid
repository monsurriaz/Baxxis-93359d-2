{{ 'expanding-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'expanding-gallery.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign desktop_height_mode = section.settings.desktop_height_mode
  assign desktop_fixed_height = section.settings.desktop_fixed_height
  assign mobile_height_mode = section.settings.mobile_height_mode
  assign mobile_fixed_height = section.settings.mobile_fixed_height
  assign column_gap = section.settings.column_gap
  assign column_gap_mobile = section.settings.column_gap_mobile
%}
{%- capture desktop_height_px -%}
  {%- case desktop_height_mode -%}
    {%- when 'fixed' -%}{{- desktop_fixed_height |  append: 'px' -}}
    {%- when 'full' -%}100svh
  {%- endcase -%}
{%- endcapture -%}

{%- capture mobile_height_px -%}
  {%- case mobile_height_mode -%}
    {%- when 'fixed' -%}{{- mobile_fixed_height |  append: 'px' -}}
    {%- when 'full' -%}100svh
  {%- endcase -%}
{%- endcapture -%}

{%- render 'top-divider', show_top_divider: section.settings.show_top_divider, divider_top_width: section.settings.divider_top_width -%}
<div class="section-expanding-gallery section-padding section-bg" {% render 'section-attributes' %}>
  <div class="{{ section.settings.section_width }}">
    {% render 'section-header', layout_header: section.settings.layout, subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, class:"header-expanding-gallery", heading_size: section.settings.heading_size_section %}
    <div class="gallery-section" style="--desktop-height:{{ desktop_height_px }};--mobile-height:{{ mobile_height_px }};--column-gap:{{ column_gap }}rem; --column-gap-mobile:{{ column_gap_mobile }}rem;--size-block:{{ section.blocks.size }}">
      <expanding-gallery 
      class="gallery-container" 
      auto-rotate="{{ section.settings.enable_auto_rotate }}" 
      rotate-interval="{{ section.settings.change_gallery_every | append:'000' }}"
      >
        {% for block in section.blocks %}
          {% liquid
          assign text_color = block.settings.text_color
          %}
          {%- unless text_color == 'rgba(0,0,0,0)' or text_color == blank  -%}
            {%- capture style -%}--color-foreground: {{ text_color.rgb }};--color-heading: {{ text_color.rgb }};{%- endcapture -%}
          {%- endunless -%}
          {%- capture var_overlay -%}
            {%- if block.settings.overlay_gradient != blank -%}
              {{ block.settings.overlay_gradient }}
            {%- else -%}
            rgba( {{ block.settings.overlay_color.rgb }} / {{ block.settings.overlay_opacity |  divided_by: 100.0 }} )
            {%- endif -%}
          {%- endcapture -%}

          {% case block.type %}
            {% when 'gallery' %}
              <div class="gallery-panel {% if forloop.first %} active {% endif %} overlay-media global-radius" style="--overlay-color:{{ var_overlay }};{{ style }};" {{ block.shopify_attributes }}>
                <div class="gallery-panel__image h-full w-full">
                  {% if block.settings.image != blank %}
                    {% render 'responsive-image', image: block.settings.image, wrapper_class: 'defer-image', sizes:'100vw' %}
                  {% else %}
                    {% render 'placeholder-image', image_placeholder: 'image' %}
                  {% endif %}
                </div>
                <div class="gallery-panel__content perpose__content justify-end absolute inset-0 flex flex-col md:p-16 p-10 items-start z-1">
                  {% if block.settings.subheading != blank %}
                    <div class="gallery-panel__subheading sub-heading">{{ block.settings.subheading }}</div>
                  {% endif %}
                  {% if block.settings.heading != blank %}
                    <div class="gallery-panel__heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</div>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <div class="gallery-panel__text rte">{{ block.settings.text }}</div>
                  {% endif %}
                  {%- if block.settings.button_label != blank -%}
                    {%- render 'button',
                      button_style: block.settings.button_type,
                      button_text: block.settings.button_label,
                      button_url:  block.settings.button_link,
                      button_type: 'link',
                      show_icon: block.settings.show_icon
                  -%}
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </expanding-gallery>
    </div>
  </div>
</div>
{%- render 'bottom-divider', show_bottom_divider: section.settings.show_bottom_divider, divider_bottom_width: section.settings.divider_bottom_width -%}
