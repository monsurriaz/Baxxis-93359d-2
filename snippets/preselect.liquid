

<div class="preselect">
  <button
    type="button"
    class="preselect__trigger"
    data-preselect-trigger
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    {%- if settings.preselect_label != blank -%}
      <span class="preselect__trigger-label">{{ settings.preselect_label }}</span>
    {%- endif -%}
    <span class="preselect__trigger-value" data-preselect-current>{{ settings.preselect_all_label | default: 'All' }}</span>
    <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
    </svg>
  </button>
</div>