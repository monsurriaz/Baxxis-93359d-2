    "collapsible_content_xgEXcW": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_cjR6gA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What materials are used to make your phone cases?",
            "icon": "clipboard",
            "row_content": "<p>Baxxis cases feature a dual-layer design for ultimate safeguarding. The silicone inner layer excels at shock absorption and scratch prevention, while the tough outer shell reinforces this, ensuring your phone remains unscathed. </p>",
            "page": ""
          }
        },
        "collapsible_row_erRaPp": {
          "type": "collapsible_row",
          "settings": {
            "heading": "When will I receive my order?",
            "icon": "truck",
            "row_content": "<p>All our items are made to order. We work to ship all orders within 1-3 days. You will receive email information once your order is dispatched. See more details on our <a href=\"https://baxxis.com/policies/shipping-policy\" target=\"_blank\" title=\"Shipping policy\">shipping page</a>.</p>",
            "page": ""
          }
        },
        "collapsible_row_QQ3bTb": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's your return policy?",
            "icon": "return",
            "row_content": "<p>We operate a 14 day returns policy which means you have 14 days from receiving the item(s) to request a return/refund. You can see full details on our <a href=\"https://baxxis.com/policies/shipping-policy\" title=\"Returns\">returns page</a>.</p>",
            "page": ""
          }
        },
        "collapsible_row_VUjqRh": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I cancel my order?",
            "icon": "question_mark",
            "row_content": "<p>Cancellations are possible if your order has not yet entered production. If you wish to cancel your order, please <a href=\"https://baxxis.com/pages/contact-us\" title=\"Contact Us\">contact us</a>.</p>",
            "page": ""
          }
        },
        "collapsible_row_x7yPCY": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I've ordered the wrong item! What do I do?",
            "icon": "return",
            "row_content": "<p>Please contact us immediately using our <a href=\"https://baxxis.com/pages/contact-us\" title=\"Contact us\">contact form</a>. We can change your order if it's not yet entered production. </p>",
            "page": ""
          }
        },
        "collapsible_row_cENGgW": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you dropship or make cases on your own?",
            "icon": "map_pin",
            "row_content": "<p>All of the cases we sell are made with our own hands and stored in Vilnius, Lithuania, where our main warehouse is.</p>",
            "page": ""
          }
        },
        "collapsible_row_3MnRCx": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you have any warranty on your cases?",
            "icon": "award",
            "row_content": "<p>Absolutely! All our cases come with a 12-month warranty. If something goes wrong, just contact us at <a href=\"mailto:support@baxxis.com\" title=\"mailto:support@baxxis.com\">support@baxxis.com</a> and we’ll make it right.</p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "collapsible_row_cjR6gA",
        "collapsible_row_erRaPp",
        "collapsible_row_QQ3bTb",
        "collapsible_row_VUjqRh",
        "collapsible_row_x7yPCY",
