#bx-listicle .p2{background:linear-gradient(120deg,#F5E3C7,#E8C98A);color:#6B4F14;}
#bx-listicle .p3{background:linear-gradient(120deg,#DCE7DF,#B7CDBF);color:#2C4A38;}
#bx-listicle .p4{background:linear-gradient(120deg,#D9E4EF,#AFC5DE);color:#233C58;}
